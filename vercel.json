{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/webhook(.*)",
      "dest": "main.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/alert",
      "dest": "main.py"
    },
    {
      "src": "/forest-alert",
      "dest": "main.py"
    },
    {
      "src": "/bot-status",
      "dest": "main.py"
    },
    {
      "src": "/scanner",
      "dest": "/scanner.html"
    },
    {
      "src": "/forest.html",
      "dest": "/forest.html"
    },
    {
      "src": "/highway.html",
      "dest": "/highway.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
